# ==============================================================================
# 🤖 BOT VPS CONTROL — KONFIGURASI ENVIRONMENT
# ==============================================================================
# Salin file ini menjadi .env, lalu isi nilainya:
#     cp .env.example .env
#
# File .env TIDAK boleh di-commit (sudah ada di .gitignore).
# ==============================================================================

# ------------------------------------------------------------------------------
# 🔑 TOKEN BOT TELEGRAM  (WAJIB)
# ------------------------------------------------------------------------------
# Dapatkan dari @BotFather di Telegram:
#   1. Kirim /newbot
#   2. Ikuti instruksi, salin token yang diberikan
#
# ⚠️ Token ini setara akses shell ke VPS kamu. Jaga kerahasiaannya.
#    Bila bocor: @BotFather → /revoke
BOT_TOKEN=ISI_TOKEN_DARI_BOTFATHER

# ------------------------------------------------------------------------------
# 👑 ADMIN IDS  (WAJIB)
# ------------------------------------------------------------------------------
# Telegram User ID yang boleh mengendalikan VPS lewat bot.
# Satu ID, atau beberapa dipisahkan koma tanpa spasi.
#
# Cara melihat User ID kamu:
#   - Kirim pesan apa pun ke @userinfobot, atau
#   - Kirim pesan apa pun ke @RawDataBot
ADMIN_IDS=123456789
# ADMIN_IDS=123456789,987654321

# ------------------------------------------------------------------------------
# 🌐 OPSIONAL — LOCAL BOT API SERVER (batas upload jadi 2GB)
# ------------------------------------------------------------------------------
# Jalankan server Telegram sendiri untuk melewati batas 20MB.
# Lihat panduan di bot: /help → 📦 Upload Besar
# API_URL=http://127.0.0.1:8081/bot
